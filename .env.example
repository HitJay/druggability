# ── 学术 API 配置 ──────────────────────────────────────────────────
# OpenAlex: 只需邮箱即可进入 polite pool (免费, 无需注册)
OPENALEX_EMAIL=your@email.com

# Semantic Scholar: 可选，无 key 也能用，申请 key 可提高速率
# 申请: https://www.semanticscholar.org/product/api#api-key
S2_API_KEY=

# NCBI / PubMed: 邮箱必填，API key 可选（提高到 10 req/s）
# 申请: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_EMAIL=your@email.com
NCBI_API_KEY=

# ── GROBID (PDF 结构化解析) ───────────────────────────────────────────
# 启动: sudo docker run -d --name grobid -p 8070:8070 lfoppiano/grobid:0.8.0
GROBID_URL=http://localhost:8070

# ── LLM 后端 (paper-qa / RAG 用) ─────────────────────────────────────
# OpenAI
OPENAI_API_KEY=

# 或本地 Ollama
# OLLAMA_BASE_URL=http://localhost:11434
